# DJI Flight Analyzer - Web App Environment Variables
# Copy to .env and fill in values (never commit .env)

# Optional: DJI Developer API key for full telemetry decryption
# Get one free at https://developer.dji.com
# Works for v13/v14 DJI Fly log formats
VITE_DJI_API_KEY=your_dji_api_key_here

# Optional: Map tile server (defaults to OpenStreetMap)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png