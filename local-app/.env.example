# DJI Flight Analyzer - Local App (FastAPI) Environment Variables
# Copy to .env and fill in values (never commit .env)

# Optional: DJI Developer API key for full telemetry decryption
# Get one free at https://developer.dji.com
# Works for v13/v14 DJI Fly log formats
DJI_API_KEY=your_dji_api_key_here

# Server config
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000